[Unit]
Description=Temple Directory database backup (%i)
After=temple-directory.service

[Service]
Type=oneshot
User=temple
Group=temple
EnvironmentFile=/etc/temple-directory/backup.env
Environment=RCLONE_CONFIG=/var/lib/temple-directory/.config/rclone/rclone.conf
ExecStart=/bin/bash /opt/temple-directory/current/deploy/server/backup.sh %i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/temple-directory
