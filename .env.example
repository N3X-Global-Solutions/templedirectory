# Copy this file to .env and adjust. Never commit the real .env.

# Shown on the login page and header
TEMPLE_NAME=Sri Angalamman kovil
TEMPLE_TAGLINE=Devotee & Donor Directory

# Server
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/temple-directory.db

# First-run accounts (used only when the account does not exist yet).
# Leave a password empty to have a random one generated and printed once in the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=

# Hours before a sign-in expires
SESSION_HOURS=12

# Set to true when served over HTTPS. Keep false only for a trusted local network over plain HTTP.
SECURE_COOKIES=false
# Number of reverse proxies in front of the app (e.g. 1 for nginx/Caddy). false when accessed directly.
TRUST_PROXY=false

# Allow the viewer login to print labels / download mailing CSV (default: admin only)
VIEWER_CAN_EXPORT=false

# Requests per minute per client IP (all API calls / CSV exports and backups)
API_RATE_LIMIT=600
EXPORT_RATE_LIMIT=20
